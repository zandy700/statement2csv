# Real statements (PDFs, broker CSV exports) and converted output must never be
# committed. Only synthetic fixtures are allowed.
*.pdf
*.PDF
*.csv
*.CSV
*.xlsx
*.XLSX
!tests/fixtures/**/*.pdf
!tests/fixtures/**/*.csv
real-data/
